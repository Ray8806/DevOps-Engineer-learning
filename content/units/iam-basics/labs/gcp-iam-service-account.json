{
  "id": "gcp-iam-service-account",
  "title": "服務帳戶與專案權限",
  "description": "建立服務帳戶、授予最小需要的角色，並移除一筆範圍太大的授權。",
  "provider": "gcp",
  "estimatedMinutes": 10,
  "initialState": {
    "files": {},
    "cloud": { "gcp": { "project": "my-project", "bindings": { "roles/editor": ["user:intern@example.com"] } } }
  },
  "steps": [
    {
      "instruction": "先用 gcloud projects get-iam-policy my-project 看看專案目前的授權，然後建立一個名為 app-reader 的服務帳戶。",
      "hint": "gcloud iam service-accounts create app-reader --display-name=\"App reader\"",
      "check": { "type": "state", "path": ["cloud", "gcp", "serviceAccounts", "app-reader@my-project.iam.gserviceaccount.com"], "exists": true }
    },
    {
      "instruction": "在專案 my-project 上，把 roles/storage.objectViewer 授予這個服務帳戶。成員要寫成 serviceAccount:app-reader@my-project.iam.gserviceaccount.com。",
      "hint": "gcloud projects add-iam-policy-binding my-project --member=\"serviceAccount:app-reader@my-project.iam.gserviceaccount.com\" --role=\"roles/storage.objectViewer\"",
      "check": {
        "type": "state",
        "path": ["cloud", "gcp", "bindings", "roles/storage.objectViewer", "serviceAccount:app-reader@my-project.iam.gserviceaccount.com"],
        "exists": true
      }
    },
    {
      "instruction": "實習生 intern@example.com 擁有 roles/editor，範圍太大了。移除這筆授權。",
      "hint": "gcloud projects remove-iam-policy-binding my-project --member=\"user:intern@example.com\" --role=\"roles/editor\"",
      "check": { "type": "state", "path": ["cloud", "gcp", "bindings", "roles/editor"], "exists": false }
    }
  ]
}
