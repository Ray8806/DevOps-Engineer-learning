    },
    {
      "aspect": "給程式用的身分",
      "aws": "IAM 角色",
      "gcp": "服務帳戶"
    },
    {
      "aspect": "現成的權限組合",
      "aws": "AWS 受管政策",
      "gcp": "預先定義的角色"
    },
    {
      "aspect": "權限的繼承",
      "aws": "政策主要附加在身分上，授權不會沿著資源階層往下繼承",
      "gcp": "機構、資料夾、專案的設定會往下繼承"
    },
    {
      "aspect": "最高權限的身分",
      "aws": "帳戶的 root 使用者",
      "gcp": "機構管理員與專案擁有者"
    }
