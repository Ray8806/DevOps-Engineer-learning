    { "aspect": "服務名稱", "aws": "Amazon EC2", "gcp": "Compute Engine" },
    { "aspect": "一台虛擬機的稱呼", "aws": "執行個體（instance）", "gcp": "執行個體（instance），也常稱 VM" },
    { "aspect": "規格", "aws": "執行個體類型，例如 t3.micro", "gcp": "機器類型，例如 e2-micro" },
    { "aspect": "作業系統範本", "aws": "AMI（Amazon Machine Image）", "gcp": "映像檔（image）" },
    { "aspect": "放置的位置", "aws": "Region 裡的 Availability Zone", "gcp": "區域（region）裡的可用區（zone）" },
    { "aspect": "防火牆", "aws": "安全群組，直接掛在執行個體上", "gcp": "VPC 防火牆規則，用網路標記指定套用到哪些執行個體" },
    { "aspect": "停止後顯示的狀態", "aws": "stopped", "gcp": "TERMINATED" },
