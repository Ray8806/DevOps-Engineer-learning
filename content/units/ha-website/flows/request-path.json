{
  "id": "request-path",
  "title": "一個請求怎麼走過高可用架構",
  "nodes": [
    {
      "id": "user",
      "label": "使用者",
      "col": 0,
      "row": 1
    },
    {
      "id": "cdn",
      "label": "CDN",
      "detail": "圖片、CSS",
      "col": 1,
      "row": 0
    },
    {
      "id": "lb",
      "label": "負載平衡器",
      "detail": "跨可用區",
      "col": 1,
      "row": 1
    },
    {
      "id": "web-a",
      "label": "網頁伺服器",
      "detail": "可用區 A",
      "col": 2,
      "row": 0
    },
    {
      "id": "web-b",
      "label": "網頁伺服器",
      "detail": "可用區 B",
      "col": 2,
      "row": 2
    },
    {
      "id": "cache",
      "label": "快取",
      "detail": "工作階段",
      "col": 3,
      "row": 0
    },
    {
      "id": "db",
      "label": "資料庫",
      "detail": "主要＋備用",
      "col": 3,
      "row": 2
    }
  ],
  "steps": [
    {
      "from": "user",
      "to": "cdn",
      "text": "圖片和 CSS 這類靜態檔案由 CDN 在離使用者近的地方回應，不會打到網頁伺服器。"
    },
    {
      "from": "user",
      "to": "lb",
      "text": "動態的請求（例如加入購物車）送到負載平衡器。"
    },
    {
      "from": "lb",
      "to": "web-a",
      "text": "負載平衡器把請求交給健康的網頁伺服器，這次是可用區 A 的那台。"
    },
    {
      "from": "web-a",
      "to": "cache",
      "text": "網頁伺服器不把登入狀態存在自己身上，而是放在共用的快取，所以下一個請求交給哪一台都可以。"
    },
    {
      "from": "lb",
      "to": "web-b",
      "text": "下一個請求交給可用區 B 的那台，它從同一個快取讀到登入狀態，使用者不會被登出。"
    },
    {
      "from": "web-b",
      "to": "db",
      "text": "訂單寫進資料庫的主要執行個體，同步複寫到另一個可用區的備用執行個體。"
    }
  ]
}
